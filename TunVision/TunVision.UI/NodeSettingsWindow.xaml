<Window x:Class="TunVision.UI.NodeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:TunVision.UI.Common"
        xmlns:controls="clr-namespace:TunVision.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding SelectedNodeTitle, StringFormat={}⚙ Cài đặt Node — {0}}"
        Width="440" Height="640"
        MinWidth="360" MinHeight="420"
        Background="#1E1E22" Foreground="#E0E0E0"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#202024" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#28282E" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E46" />
        <SolidColorBrush x:Key="AccentOrange" Color="#E67E22" />
        <SolidColorBrush x:Key="AccentBlue" Color="#00A8FF" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <common:FlexibleFloatConverter x:Key="NumConv" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#151518" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#E67E22" />
            <Setter Property="BorderBrush" Value="#44444C" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,3,0,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}" />

        <!-- Dark-Themed ComboBoxItem Style (High Contrast White Text on Dark Background) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#202026" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="#FFFFFF" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#D35400" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A2818" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark-Themed ComboBox Style (Fixes light background / invisible text issue) -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#151518" />
            <Setter Property="BorderBrush" Value="#484852" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,3,0,7" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxBorder"
                                                Background="#151518"
                                                BorderBrush="#484852"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="#E67E22"
                                                      StrokeThickness="1.8"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#E67E22" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,28,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="#FFFFFF" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#202026"
                                            BorderBrush="#E67E22"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#323238" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#55555E" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,5" />
        </Style>

        <!-- Dark-Themed TabControl & TabItem Styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1E1E22" />
            <Setter Property="BorderBrush" Value="#3E3E46" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A8A8B2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#18181C" BorderBrush="#383842" BorderThickness="0,0,1,2" Padding="14,8" Margin="0">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#25252C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#24242B" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#E67E22" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,1,3" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunPipelineCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#25252B" BorderBrush="#E67E22" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding Loc.RunBtnText}" Click="OnRunTestClick"
                        Background="#D35400" BorderBrush="#E67E22" Padding="12,4" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙ " Foreground="#E67E22" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="{Binding SelectedNodeTitle}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2-Tab Container: Tab 1 = Parameters, Tab 2 = Input/Output Guide -->
        <TabControl Grid.Row="1">
            <TabItem Header="⚙ Thông số cài đặt">
                <!-- Scrollable Settings Content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel>

                <!-- 1. ShapeMatchNode Inspector -->
                <StackPanel Visibility="{Binding IsShapeMatchSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loc.ShapeMatchHeader}" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />

                    <Border Background="#16161A" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.ModelStatusLabel}" Foreground="#999999" FontSize="10.5" />
                            <TextBlock Text="{Binding CurrentShapeMatchNode.ModelStatusText}" Foreground="#2ECC71" FontWeight="SemiBold" Margin="0,3,0,2" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- G2 Dedicated Model Preview Control -->
                    <controls:ModelPreviewControl x:Name="ShapeMatchModelPreview"
                                                  Model="{Binding CurrentShapeMatchNode.Model, Mode=OneWay}"
                                                  HorizontalAlignment="Center" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding Loc.LoadShmBtn}" Command="{Binding BrowseModelFileCommand}" Margin="0,0,3,0" Background="#2B579A" />
                        <Button Grid.Column="1" Content="{Binding Loc.SaveShmBtn}" Command="{Binding SaveModelFileCommand}" Margin="3,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding Loc.SelectRoiToolBtn}" Command="{Binding SetDrawRoiModeCommand}" Background="#005A9E" Margin="0,0,3,0" />
                        <Button Grid.Column="1" Content="{Binding Loc.TrainCurrentBtn}" Command="{Binding TrainModelNowCommand}" Background="#D35400" Margin="3,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding Loc.EraserBrushBtn}" Command="{Binding SetBrushEraseModeCommand}" Background="#8B2635" FontSize="11" />
                        <Button Grid.Column="1" Content="{Binding Loc.EraserBoxBtn}" Command="{Binding SetBoxEraseModeCommand}" Background="#7A3E00" FontSize="11" />
                        <Button Grid.Column="2" Content="{Binding Loc.UndoEraseBtn}" Command="{Binding UndoEraseCommand}" FontSize="11" />
                    </Grid>

                    <Button Content="{Binding Loc.SetOriginFromMatchBtn}" Command="{Binding SetOriginFromMatchCommand}" Background="#1E5631" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding Loc.ContourModeLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableContourModes}" SelectedItem="{Binding CurrentShapeMatchNode.ContourMode, Mode=TwoWay}" />

                    <!-- G3 Auto-Balancing ContrastLow (Cyan), ContrastHigh (Green), NumLevels (Red) & LowestPyramid (G7) -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.ContrastLowLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Margin="4,3,0,7"
                                        Background="#00FFFF" Foreground="#002222" BorderBrush="#88FFFF"
                                        Content="⚡" ToolTip="Tự động cân bằng ContrastLow theo phân vị P70 (Cyan)"
                                        Command="{Binding AutoBalanceContrastLowCommand}" />
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentShapeMatchNode.ContrastLow, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.ContrastHighLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Margin="4,3,0,7"
                                        Background="#00AA00" Foreground="#FFFFFF" BorderBrush="#55DD55"
                                        Content="⚡" ToolTip="Tự động cân bằng ContrastHigh theo phân vị P85 (Green)"
                                        Command="{Binding AutoBalanceContrastHighCommand}" />
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentShapeMatchNode.ContrastHigh, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="NumLevels (Số tầng tháp, 0=Auto):" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Margin="4,3,0,7"
                                        Background="#FF0000" Foreground="#FFFFFF" BorderBrush="#FF7777"
                                        Content="⚡" ToolTip="Tự động tính số tầng tháp ảnh NumLevels theo công thức Log2 (Red)"
                                        Command="{Binding AutoBalanceNumLevelsCommand}" />
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentShapeMatchNode.PyramidLevels, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="LowestPyramid (Tầng dừng 1–10):" />
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentShapeMatchNode.LowestPyramid, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Tìm kiếm ảnh lớn (SearchModel Big — Chia ô 2048px)"
                              IsChecked="{Binding CurrentShapeMatchNode.UseTiledSearch, Mode=TwoWay}"
                              Margin="0,0,0,6" />

                    <!-- MinContrast & MinComponentSize Parameters (R4) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.MinContrastLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentShapeMatchNode.MinContrast, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.MinComponentSizeLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentShapeMatchNode.MinComponentSize, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.MinScoreLabel}" />
                            <TextBox Text="{Binding CurrentShapeMatchNode.MinScore, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.GreedinessLabel}" />
                            <TextBox Text="{Binding CurrentShapeMatchNode.Greediness, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.AngleMinLabel}" />
                            <TextBox Text="{Binding CurrentShapeMatchNode.AngleMinDeg, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.AngleMaxLabel}" />
                            <TextBox Text="{Binding CurrentShapeMatchNode.AngleMaxDeg, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.ScaleMinLabel}" />
                            <TextBox Text="{Binding CurrentShapeMatchNode.ScaleMin, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.ScaleMaxLabel}" />
                            <TextBox Text="{Binding CurrentShapeMatchNode.ScaleMax, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.MaxInstancesLabel}" />
                            <TextBox Text="{Binding CurrentShapeMatchNode.MaxInstances, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.MaxOverlapLabel}" />
                            <TextBox Text="{Binding CurrentShapeMatchNode.MaxOverlap, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 2. ToleranceVerdictNode Inspector -->
                <StackPanel Visibility="{Binding IsToleranceVerdictSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loc.ToleranceHeader}" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding Loc.CaptureNominalsBtn}" Command="{Binding CaptureNominalsCommand}" Background="#107C41" Padding="8,6" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Content="{Binding Loc.ClearRulesBtn}" Command="{Binding ClearToleranceRulesCommand}" Padding="6,6" Margin="4,0,0,0" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding ToleranceRules}" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#16161A" RowBackground="#222226" AlternatingRowBackground="#1C1C20"
                              Foreground="#FFFFFF" BorderBrush="#3E3E44" BorderThickness="1" MaxHeight="280" Margin="0,0,0,10" FontSize="11.5">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Bật" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Phép đo" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Chuẩn" Binding="{Binding Nominal, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Width="65" />
                            <DataGridTextColumn Header="-Tol" Binding="{Binding MinusTolerance, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Width="52" />
                            <DataGridTextColumn Header="+Tol" Binding="{Binding PlusTolerance, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Width="52" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Cổng đơn (Single Port Fallback):" Foreground="#888888" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding Loc.NominalValueLabel}" />
                    <TextBox Text="{Binding CurrentToleranceVerdictNode.Nominal, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.MinToleranceLabel}" />
                            <TextBox Text="{Binding CurrentToleranceVerdictNode.MinTolerance, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.MaxToleranceLabel}" />
                            <TextBox Text="{Binding CurrentToleranceVerdictNode.MaxTolerance, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 3. CaliperCircleNode (Search Circle) Inspector -->
                <StackPanel Visibility="{Binding IsCaliperCircleSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loc.CaliperHeader}" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Center X (px):" />
                            <TextBox Text="{Binding CurrentCaliperCircleNode.CenterX, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Center Y (px):" />
                            <TextBox Text="{Binding CurrentCaliperCircleNode.CenterY, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.ExpectedRadiusLabel}" />
                            <TextBox Text="{Binding CurrentCaliperCircleNode.ExpectedRadius, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Bề rộng vành (Annulus):" />
                            <TextBox Text="{Binding CurrentCaliperCircleNode.SearchRange, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Số thước đo (Calipers):" />
                            <TextBox Text="{Binding CurrentCaliperCircleNode.NumSpokes, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Ngưỡng biên (Threshold):" />
                            <TextBox Text="{Binding CurrentCaliperCircleNode.Threshold, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Hướng quét (Inward / Outward):" />
                    <ComboBox ItemsSource="{Binding AvailableScanDirections}" SelectedItem="{Binding CurrentCaliperCircleNode.ScanDirection, Mode=TwoWay}" />

                    <TextBlock Text="Cực tính biên (Polarity):" />
                    <ComboBox ItemsSource="{Binding AvailablePolarities}" SelectedItem="{Binding CurrentCaliperCircleNode.Polarity, Mode=TwoWay}" />

                    <TextBlock Text="Chọn điểm biên (Selection):" />
                    <ComboBox ItemsSource="{Binding AvailableSelections}" SelectedItem="{Binding CurrentCaliperCircleNode.Selection, Mode=TwoWay}" />
                </StackPanel>

                <!-- 4. SearchLineNode Inspector -->
                <StackPanel Visibility="{Binding IsSearchLineSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="THAM SỐ DÒ ĐƯỜNG THẲNG (SEARCH LINE)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Start X:" />
                            <TextBox Text="{Binding CurrentSearchLineNode.StartX, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Start Y:" />
                            <TextBox Text="{Binding CurrentSearchLineNode.StartY, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="End X:" />
                            <TextBox Text="{Binding CurrentSearchLineNode.EndX, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="End Y:" />
                            <TextBox Text="{Binding CurrentSearchLineNode.EndY, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Bề rộng dò (Half Width):" />
                            <TextBox Text="{Binding CurrentSearchLineNode.SearchHalfWidth, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Số thước đo (Calipers):" />
                            <TextBox Text="{Binding CurrentSearchLineNode.NumCalipers, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Ngưỡng biên (Threshold):" />
                    <TextBox Text="{Binding CurrentSearchLineNode.Threshold, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="Cực tính biên (Polarity):" />
                    <ComboBox ItemsSource="{Binding AvailablePolarities}" SelectedItem="{Binding CurrentSearchLineNode.Polarity, Mode=TwoWay}" />
                </StackPanel>

                <!-- 5. SearchCornerNode Inspector -->
                <StackPanel Visibility="{Binding IsSearchCornerSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="THAM SỐ DÒ GÓC / GIAO ĐIỂM (SEARCH CORNER)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <TextBlock Text="Cạnh 1 (Line 1 Start X, Y / End X, Y):" Foreground="#00E5FF" Margin="0,2,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CurrentSearchCornerNode.Line1StartX, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Margin="2" />
                        <TextBox Grid.Column="1" Text="{Binding CurrentSearchCornerNode.Line1StartY, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Margin="2" />
                        <TextBox Grid.Column="2" Text="{Binding CurrentSearchCornerNode.Line1EndX, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Margin="2" />
                        <TextBox Grid.Column="3" Text="{Binding CurrentSearchCornerNode.Line1EndY, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Margin="2" />
                    </Grid>
                    <TextBlock Text="Cạnh 2 (Line 2 Start X, Y / End X, Y):" Foreground="#00E5FF" Margin="0,6,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CurrentSearchCornerNode.Line2StartX, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Margin="2" />
                        <TextBox Grid.Column="1" Text="{Binding CurrentSearchCornerNode.Line2StartY, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Margin="2" />
                        <TextBox Grid.Column="2" Text="{Binding CurrentSearchCornerNode.Line2EndX, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Margin="2" />
                        <TextBox Grid.Column="3" Text="{Binding CurrentSearchCornerNode.Line2EndY, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" Margin="2" />
                    </Grid>
                    <TextBlock Text="Bề rộng dò (Half Width):" Margin="0,6,0,0" />
                    <TextBox Text="{Binding CurrentSearchCornerNode.SearchHalfWidth, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="Ngưỡng biên (Threshold):" />
                    <TextBox Text="{Binding CurrentSearchCornerNode.Threshold, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <!-- 6. PointToPointNode Inspector -->
                <StackPanel Visibility="{Binding IsPointToPointSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="KHOẢNG CÁCH ĐIỂM - ĐIỂM (POINT TO POINT)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <Border Background="#16161A" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentPointToPointNode.LastResult}" Foreground="#2ECC71" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="Nối cổng Point A và Point B từ tâm đường tròn, trung điểm cạnh hoặc đỉnh góc trên sơ đồ." Foreground="#999999" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 7. BlobDetectNode Inspector -->
                <StackPanel Visibility="{Binding IsBlobSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="PHÂN TÍCH VÙNG &amp; HÌNH THÁI HỌC (BLOB)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <TextBlock Text="Chế độ phân ngưỡng:" />
                    <ComboBox ItemsSource="{Binding AvailableThresholdModes}" SelectedItem="{Binding CurrentBlobNode.ToolInstance.ThresholdMode, Mode=TwoWay}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Ngưỡng dưới:" />
                            <TextBox Text="{Binding CurrentBlobNode.ToolInstance.ThresholdLow, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Ngưỡng trên:" />
                            <TextBox Text="{Binding CurrentBlobNode.ToolInstance.ThresholdHigh, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Đảo ngược nền (Invert)" IsChecked="{Binding CurrentBlobNode.ToolInstance.Invert, Mode=TwoWay}" />
                    <CheckBox Content="Lấp đầy lỗ thủng (Fill Up Holes)" IsChecked="{Binding CurrentBlobNode.ToolInstance.FillUpHoles, Mode=TwoWay}" />
                    <TextBlock Text="Phép toán hình thái học (Morphology):" />
                    <ComboBox ItemsSource="{Binding AvailableMorphOps}" SelectedItem="{Binding CurrentBlobNode.ToolInstance.Morphology, Mode=TwoWay}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Diện tích tối thiểu:" />
                            <TextBox Text="{Binding CurrentBlobNode.ToolInstance.MinArea, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Diện tích tối đa:" />
                            <TextBox Text="{Binding CurrentBlobNode.ToolInstance.MaxArea, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 8. TrainShapeModelNode Inspector -->
                <StackPanel Visibility="{Binding IsTrainShapeSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loc.TrainShapeHeader}" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />

                    <Border Background="#16161A" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.ModelTrainStatusLabel}" Foreground="#999999" FontSize="10.5" />
                            <TextBlock Text="{Binding CurrentTrainShapeNode.LastResult}" Foreground="#2ECC71" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,2" />
                        </StackPanel>
                    </Border>

                    <!-- G2 Dedicated Model Preview Control -->
                    <controls:ModelPreviewControl x:Name="TrainShapeModelPreview"
                                                  Model="{Binding CurrentTrainShapeNode.ToolInstance.Model, Mode=OneWay}"
                                                  HorizontalAlignment="Center" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding Loc.TemplateImgFileLabel}" />
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CurrentTrainShapeNode.TemplateImagePath, Mode=TwoWay}" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Content="{Binding Loc.BrowseFileBtn}" Command="{Binding BrowseTrainTemplateImageCommand}" Padding="10,4" />
                    </Grid>

                    <TextBlock Text="{Binding Loc.ContourModeLabel}" />
                    <ComboBox ItemsSource="{Binding AvailableContourModes}" SelectedItem="{Binding CurrentTrainShapeNode.ContourMode, Mode=TwoWay}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.ContrastLowLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Margin="4,3,0,7"
                                        Background="#00FFFF" Foreground="#002222" BorderBrush="#88FFFF"
                                        Content="⚡" ToolTip="Tự động cân bằng ContrastLow theo phân vị P70 (Cyan)"
                                        Command="{Binding AutoBalanceContrastLowCommand}" />
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentTrainShapeNode.ContrastLow, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.ContrastHighLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Margin="4,3,0,7"
                                        Background="#00AA00" Foreground="#FFFFFF" BorderBrush="#55DD55"
                                        Content="⚡" ToolTip="Tự động cân bằng ContrastHigh theo phân vị P85 (Green)"
                                        Command="{Binding AutoBalanceContrastHighCommand}" />
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentTrainShapeNode.ContrastHigh, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <!-- NumLevels (Red Auto) & LowestPyramid (1-10) -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="NumLevels (Số tầng tháp ảnh, 0=Auto):" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Margin="4,3,0,7"
                                        Background="#FF0000" Foreground="#FFFFFF" BorderBrush="#FF7777"
                                        Content="⚡" ToolTip="Tự động tính số tầng tháp ảnh NumLevels theo công thức Log2 (Red)"
                                        Command="{Binding AutoBalanceNumLevelsCommand}" />
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentTrainShapeNode.PyramidLevels, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="LowestPyramid (Tầng dừng sớm 1–10):" />
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentTrainShapeNode.LowestPyramid, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- MinContrast & MinComponentSize (R4) -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.MinContrastLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentTrainShapeNode.MinContrast, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.MinComponentSizeLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CurrentTrainShapeNode.MinComponentSize, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Loc.ExportShmPathLabel}" />
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CurrentTrainShapeNode.ExportPath, Mode=TwoWay}" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Content="{Binding Loc.BrowseSaveBtn}" Command="{Binding BrowseTrainExportModelCommand}" Padding="10,4" />
                    </Grid>
                </StackPanel>

                <!-- 9. RoiRectangleNode Inspector -->
                <StackPanel Visibility="{Binding IsRoiRectSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loc.RoiRectHeader}" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="X:" />
                            <TextBox Text="{Binding CurrentRoiRectNode.X, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Y:" />
                            <TextBox Text="{Binding CurrentRoiRectNode.Y, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{Binding Loc.WidthLabel}" />
                            <TextBox Text="{Binding CurrentRoiRectNode.Width, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{Binding Loc.HeightLabel}" />
                            <TextBox Text="{Binding CurrentRoiRectNode.Height, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Góc xoay (°):" />
                    <TextBox Text="{Binding CurrentRoiRectNode.AngleDeg, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <!-- 9b. RoiCircleNode Inspector -->
                <StackPanel Visibility="{Binding IsRoiCircleSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="VÙNG ROI HÌNH TRÒN (ROI CIRCLE)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Tâm X (Center X):" />
                            <TextBox Text="{Binding CurrentRoiCircleNode.CenterX, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Tâm Y (Center Y):" />
                            <TextBox Text="{Binding CurrentRoiCircleNode.CenterY, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Bán kính (Radius px):" />
                    <TextBox Text="{Binding CurrentRoiCircleNode.Radius, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <!-- 9b-2. RoiPolygonNode Inspector (G5) -->
                <StackPanel Visibility="{Binding IsRoiPolygonSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="VÙNG ROI ĐA GIÁC TỰ DO (ROI POLYGON)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <Border Background="#16161A" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentRoiPolygonNode.VertexCount, StringFormat={}Số đỉnh hiện tại: {0} đỉnh}"
                                       Foreground="#00E5FF" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="Kéo từng đỉnh trắng hoặc tâm vàng trực tiếp trên ảnh. Chuột phải vào cạnh để thêm đỉnh mới; chuột phải vào đỉnh để xóa bớt (tối thiểu 3 đỉnh)."
                                       Foreground="#999999" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+ Thêm đỉnh" Command="{Binding AddPolygonVertexCommand}" Background="#1E5631" FontSize="11" />
                        <Button Grid.Column="1" Content="- Xóa đỉnh" Command="{Binding RemovePolygonVertexCommand}" Background="#8B2635" FontSize="11" />
                        <Button Grid.Column="2" Content="↺ Đặt lại 4 đỉnh" Command="{Binding ResetPolygonQuadCommand}" FontSize="11" />
                    </Grid>
                </StackPanel>

                <!-- 9c. FixtureNode Inspector -->
                <StackPanel Visibility="{Binding IsFixtureSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="GỐC TỌA ĐỘ ĐỘNG (FIXTURE COORDINATE)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <Border Background="#16161A" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentFixtureNode.LastResult}" Foreground="#2ECC71" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Nối cổng Pose từ node Contour Matching vào cổng Pose của Fixture, sau đó nối cổng Fixture sang các node đo hình học (Search Circle, Search Line, Search Corner) để bù dịch chuyển &amp; góc xoay tự động." Foreground="#999999" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 9d. CropNode Inspector -->
                <StackPanel Visibility="{Binding IsCropSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="CẮT VÙNG ẢNH (CROP ROI)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <Border Background="#16161A" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentCropNode.LastResult}" Foreground="#2ECC71" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Nối cổng Image từ Nguồn ảnh và cổng ROI từ node ROI Rectangle / ROI Circle vào node Crop ROI." Foreground="#999999" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 10. Calibration / CSV / FileRoute Inspectors -->
                <StackPanel Visibility="{Binding IsCalibrationSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="HIỆU CHUẨN ĐƠN VỊ BẰNG THƯỚC ĐO 2 ĐIỂM (PX → MM)" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />

                    <CheckBox Content="Bật quy đổi đơn vị sang thực tế (mm)" IsChecked="{Binding CurrentCalibrationNode.Enabled, Mode=TwoWay}" Margin="0,0,0,8" />

                    <Button Content="📏 Kéo vẽ đoạn thẳng 2 điểm trên ảnh" Command="{Binding SetDrawRoiModeCommand}"
                            Background="#2B579A" BorderBrush="#4A90E2" Padding="10,6" Margin="0,0,0,8" />

                    <!-- Live Pixel Distance & Formula Readout Card -->
                    <Border Background="#131922" BorderBrush="#00A8FF" BorderThickness="1.2" CornerRadius="5" Padding="12,9" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="1. Độ dài đoạn thẳng đo được trên ảnh:" Foreground="#98B8D8" FontSize="11.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,6">
                                <TextBlock Text="{Binding CurrentCalibrationNode.PixelDistance, StringFormat={}{0:F2}}"
                                           Foreground="#00E5FF" FontWeight="Bold" FontSize="20" />
                                <TextBlock Text=" px (pixel)" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                            </StackPanel>
                            <Border Background="#1A2430" CornerRadius="4" Padding="8,5">
                                <TextBlock Text="{Binding CurrentCalibrationNode.CalibrationFormulaText}"
                                           Foreground="#58F098" FontWeight="SemiBold" FontSize="11.5" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="2. Nhập độ dài thực tế của đoạn thẳng vừa đo (mm):" FontWeight="SemiBold" Foreground="#FFD166" />
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Kích thước thực tế (ví dụ: 10.0):" Foreground="#AAAAAA" FontSize="11" />
                            <TextBox Text="{Binding CurrentCalibrationNode.KnownRealLength, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}"
                                     FontWeight="Bold" FontSize="13.5" BorderBrush="#E67E22" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Đơn vị:" Foreground="#AAAAAA" FontSize="11" />
                            <TextBox Text="{Binding CurrentCalibrationNode.UnitName, Mode=TwoWay}" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="3. Hệ số quy đổi tự động (1 pixel = bao nhiêu mm):" Margin="0,4,0,0" />
                    <TextBox Text="{Binding CurrentCalibrationNode.MmPerPixel, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Text="Tọa độ 2 đầu mút đoạn chuẩn trên ảnh (kéo điểm Vàng &amp; Trắng trên ảnh):" Foreground="#00E5FF" Margin="0,6,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                            <TextBlock Text="X1:" FontSize="10.5" Foreground="#999999" />
                            <TextBox Text="{Binding CurrentCalibrationNode.Point1X, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                            <TextBlock Text="Y1:" FontSize="10.5" Foreground="#999999" />
                            <TextBox Text="{Binding CurrentCalibrationNode.Point1Y, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="3,0,3,0">
                            <TextBlock Text="X2:" FontSize="10.5" Foreground="#999999" />
                            <TextBox Text="{Binding CurrentCalibrationNode.Point2X, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="3,0,0,0">
                            <TextBlock Text="Y2:" FontSize="10.5" Foreground="#999999" />
                            <TextBox Text="{Binding CurrentCalibrationNode.Point2Y, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding IsCsvExportSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="GHI KẾT QUẢ RA FILE CSV" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <CheckBox Content="Bật tự động ghi CSV" IsChecked="{Binding CurrentCsvExportNode.Enabled, Mode=TwoWay}" />
                    <TextBlock Text="Đường dẫn file .csv:" />
                    <TextBox Text="{Binding CurrentCsvExportNode.CsvFilePath, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsFileRouteSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="CHUYỂN FILE ẢNH OK / NG" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />
                    <CheckBox Content="Bật tự động lưu ảnh OK / NG" IsChecked="{Binding CurrentFileRouteNode.Enabled, Mode=TwoWay}" />
                    <TextBlock Text="Thư mục gốc xuất ảnh:" />
                    <TextBox Text="{Binding CurrentFileRouteNode.OutputBaseFolder, Mode=TwoWay}" />
                </StackPanel>

                <!-- 11. SourceImageNode Inspector -->
                <StackPanel Visibility="{Binding IsSourceImageSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Loc.SourceImgHeader}" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,8" />

                    <Border Background="#16161A" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc.SelectedImageLabel}" Foreground="#999999" FontSize="10.5" />
                            <TextBlock Text="{Binding CurrentSourceNode.FileName}" Foreground="#2ECC71" FontWeight="Bold" FontSize="12.5" Margin="0,2,0,2" />
                            <TextBlock Text="{Binding CurrentSourceNode.ImagePath}" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentSourceNode.ImagePath}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding Loc.SelectImageBtn}" Command="{Binding BrowseSourceImageCommand}" Margin="0,0,3,0" Background="#2B579A" />
                        <Button Grid.Column="1" Content="{Binding Loc.SelectFolderBtn}" Command="{Binding BrowseSourceFolderCommand}" Margin="3,0,0,0" />
                    </Grid>

                    <Border Background="#25252B" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                        <DockPanel>
                            <Button Content="{Binding Loc.PrevBtn}" Command="{Binding PrevSourceImageCommand}" Padding="10,3" />
                            <Button Content="{Binding Loc.NextBtn}" Command="{Binding NextSourceImageCommand}" Padding="10,3" DockPanel.Dock="Right" />
                            <TextBlock Text="{Binding CurrentSourceNode.IndexDisplay, StringFormat={}Image: {0}}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#00E5FF" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding Loc.ImagesInFolderLabel}" Margin="0,2,0,4" Foreground="#AAAAAA" />
                    <ListBox ItemsSource="{Binding CurrentSourceNode.FolderFileItems}" SelectedItem="{Binding SelectedSourceFileItem, Mode=TwoWay}"
                             MaxHeight="240" Background="#151518" BorderBrush="#3A3A42" Foreground="#DDDDDD" FontSize="11.5" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" Margin="3,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- 17. ImageFilterNode Inspector -->
                <StackPanel Visibility="{Binding IsImageFilterSelected, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="↺ Đặt lại mặc định" Command="{Binding ResetImageFilterCommand}"
                                Background="#383844" Padding="8,3" FontSize="11" />
                        <TextBlock Text="LỌC &amp; CHỈNH SÁNG ẢNH (IMAGE FILTER)" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 1. Chuyển đổi hệ màu / Kênh màu -->
                    <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1. Chế độ màu / Tách kênh màu (Color Mode):" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableColorModes}"
                                      SelectedItem="{Binding CurrentImageFilterNode.ColorMode, Mode=TwoWay}" />
                            <TextBlock Text="Original: Giữ nguyên | Grayscale: Ảnh xám | Red/Green/Blue: Tách kênh RGB | HsvHue/Sat/Val: Kênh HSV | PseudoJet/Hot: Bản đồ nhiệt"
                                       Foreground="#888894" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Phơi sáng, Độ tương phản, Gamma & Độ bão hòa -->
                    <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2. Phơi sáng &amp; Độ tương phản (Exposure / Contrast / Gamma):" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,0,6" />

                            <!-- Exposure (-100 to +100) -->
                            <DockPanel Margin="0,2,0,2">
                                <TextBox DockPanel.Dock="Right" Width="64" Margin="8,0,0,0"
                                         Text="{Binding CurrentImageFilterNode.Exposure, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Độ phơi sáng / Độ sáng (-100 đến +100):" />
                            </DockPanel>
                            <Slider Minimum="-100" Maximum="100" TickFrequency="5" SmallChange="1" LargeChange="10"
                                    Value="{Binding CurrentImageFilterNode.Exposure, Mode=TwoWay}" Margin="0,0,0,8" />

                            <!-- Contrast (0.1 to 4.0) -->
                            <DockPanel Margin="0,2,0,2">
                                <TextBox DockPanel.Dock="Right" Width="64" Margin="8,0,0,0"
                                         Text="{Binding CurrentImageFilterNode.Contrast, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Độ tương phản — Contrast (0.1 – 4.0, chuẩn = 1.0):" />
                            </DockPanel>
                            <Slider Minimum="0.1" Maximum="4.0" TickFrequency="0.1" SmallChange="0.05" LargeChange="0.2"
                                    Value="{Binding CurrentImageFilterNode.Contrast, Mode=TwoWay}" Margin="0,0,0,8" />

                            <!-- Gamma (0.1 to 5.0) -->
                            <DockPanel Margin="0,2,0,2">
                                <TextBox DockPanel.Dock="Right" Width="64" Margin="8,0,0,0"
                                         Text="{Binding CurrentImageFilterNode.Gamma, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Hiệu chỉnh Gamma (0.1 – 5.0, &gt;1 làm sáng vùng tối):" />
                            </DockPanel>
                            <Slider Minimum="0.1" Maximum="5.0" TickFrequency="0.1" SmallChange="0.05" LargeChange="0.25"
                                    Value="{Binding CurrentImageFilterNode.Gamma, Mode=TwoWay}" Margin="0,0,0,8" />

                            <!-- Saturation (0.0 to 3.0) -->
                            <DockPanel Margin="0,2,0,2">
                                <TextBox DockPanel.Dock="Right" Width="64" Margin="8,0,0,0"
                                         Text="{Binding CurrentImageFilterNode.Saturation, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Độ bão hòa màu — Saturation (0.0 – 3.0):" />
                            </DockPanel>
                            <Slider Minimum="0.0" Maximum="3.0" TickFrequency="0.1" SmallChange="0.05" LargeChange="0.2"
                                    Value="{Binding CurrentImageFilterNode.Saturation, Mode=TwoWay}" Margin="0,0,0,4" />

                            <CheckBox Content="Cân bằng sáng cục bộ tự động (CLAHE — chống lóa/bóng đổ)"
                                      IsChecked="{Binding CurrentImageFilterNode.AutoClahe, Mode=TwoWay}" Margin="0,4,0,2" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Bộ lọc không gian (Khử nhiễu / Làm nét / Hình thái học) -->
                    <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="3. Bộ lọc khử nhiễu &amp; Làm sắc nét biên (Spatial Filter):" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Loại bộ lọc:" />
                                    <ComboBox ItemsSource="{Binding AvailableFilterOps}"
                                              SelectedItem="{Binding CurrentImageFilterNode.FilterOperation, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Cỡ nhân (lẻ 1–31):" />
                                    <TextBox Text="{Binding CurrentImageFilterNode.KernelSize, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Phân ngưỡng nhị phân & Đảo ngược âm bản -->
                    <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="4. Phân ngưỡng &amp; Âm bản (Threshold / Invert):" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,0,4" />
                            <CheckBox Content="Đảo ngược màu âm bản (Invert — Trắng ↔ Đen)"
                                      IsChecked="{Binding CurrentImageFilterNode.Invert, Mode=TwoWay}" />
                            <CheckBox Content="Bật phân ngưỡng nhị phân (Binary Threshold)"
                                      IsChecked="{Binding CurrentImageFilterNode.EnableThreshold, Mode=TwoWay}" />
                            <DockPanel Margin="0,4,0,2">
                                <TextBox DockPanel.Dock="Right" Width="64" Margin="8,0,0,0"
                                         Text="{Binding CurrentImageFilterNode.ThresholdValue, Mode=TwoWay, Converter={StaticResource NumConv}, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Ngưỡng nhị phân (0 – 255):" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="255" TickFrequency="5" SmallChange="1" LargeChange="15"
                                    Value="{Binding CurrentImageFilterNode.ThresholdValue, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 18. ScanQrNode & ScanBarcodeNode Inspector -->
                <StackPanel Visibility="{Binding IsCodeReaderSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ĐỌC MÃ 1D / 2D (ZXING BARCODE &amp; QR CODE)" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8" />

                    <!-- Kết quả đọc chuỗi (Decoded Result Banner) -->
                    <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Nội dung mã đọc được:" Foreground="#999999" FontSize="11" />
                                <TextBlock Text="{Binding CurrentCodeReaderNode.LastCodeResult.FormatName, StringFormat={}[{0}]}" 
                                           HorizontalAlignment="Right" Foreground="#FFD166" FontWeight="SemiBold" FontSize="11.5" />
                            </DockPanel>
                            <TextBox Text="{Binding CurrentCodeReaderNode.LastCodeResult.Text, Mode=OneWay}" 
                                     IsReadOnly="True" FontWeight="Bold" FontSize="14" Foreground="#2ECC71" 
                                     Background="#0E0E12" BorderBrush="#2ECC71" Padding="8,6" TextWrapping="Wrap" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CurrentCodeReaderNode.LastCodeResult.Center.X, StringFormat={}Tâm X: {0:F1} px}" Foreground="#AAAAAA" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding CurrentCodeReaderNode.LastCodeResult.Center.Y, StringFormat={}Tâm Y: {0:F1} px}" Foreground="#AAAAAA" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 1. Chuẩn loại mã (Code Format) -->
                    <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1. Loại mã kỳ vọng (Expected Format):" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableCodeKinds}"
                                      SelectedItem="{Binding CurrentCodeReaderNode.ExpectedKind, Mode=TwoWay}" />
                            <TextBlock Text="AutoDetect: Tự nhận diện mọi loại mã | QrCode / DataMatrix: Mã ma trận 2D | Code128 / Code39 / Ean13: Mã vạch 1D"
                                       Foreground="#888894" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Tùy chọn nâng cao (Try Harder & Inverted) -->
                    <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2. Tùy chọn quét tối ưu (Scan Options):" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,0,4" />
                            <CheckBox Content="Dò tìm chuyên sâu (Try Harder — tăng độ nhạy cho mã mờ/nghiêng)"
                                      IsChecked="{Binding CurrentCodeReaderNode.TryHarder, Mode=TwoWay}" Margin="0,3,0,4" />
                            <CheckBox Content="Đọc mã màu âm bản (Try Inverted — chữ trắng nền đen / khắc laser)"
                                      IsChecked="{Binding CurrentCodeReaderNode.TryInverted, Mode=TwoWay}" Margin="0,0,0,2" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Đối chiếu & Kiểm tra chuỗi (String Verification) -->
                    <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="3. Đối chiếu chuỗi ký tự (String Verification):" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,0,4" />
                            <TextBlock Text="Quy tắc đối chiếu:" Margin="0,2,0,2" />
                            <ComboBox ItemsSource="{Binding AvailableMatchRules}"
                                      SelectedItem="{Binding CurrentCodeReaderNode.MatchRule, Mode=TwoWay}" />
                            <TextBlock Text="Chuỗi mẫu kỳ vọng (Expected Text):" Margin="0,4,0,2" />
                            <TextBox Text="{Binding CurrentCodeReaderNode.ExpectedText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="None: Luôn Pass nếu đọc được mã | Equals: Phải giống hệt | Contains: Chứa từ khóa | StartsWith: Bắt đầu bằng"
                                       Foreground="#888894" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TAB 2: HƯỚNG DẪN ĐẦU VÀO / ĐẦU RA & CÁCH DÙNG ==================== -->
            <TabItem Header="📖 Hướng dẫn (Đầu vào / Đầu ra)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel>
                        <!-- 1. Chức năng chính -->
                        <TextBlock Text="1. CHỨC NĂNG CỦA THẺ" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,5" />
                        <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedNodeGuide.Summary}" Foreground="#E8E8F0" TextWrapping="Wrap" LineHeight="18" />
                        </Border>

                        <!-- 2. Các cổng Đầu vào (Inputs - Bên trái thẻ) -->
                        <TextBlock Text="2. CỔNG ĐẦU VÀO (INPUTS — BÊN TRÁI THẺ)" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,5" />
                        <Border Background="#16161B" BorderBrush="#383842" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,6"
                                Visibility="{Binding SelectedNodeGuide.HasNoInputs, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Thẻ này là nguồn khởi đầu độc lập, không cần nối cổng đầu vào." Foreground="#9999A5" FontStyle="Italic" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding SelectedNodeGuide.Inputs}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16161B" BorderBrush="#34343E" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,5">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Ellipse Width="10" Height="10" Fill="{Binding PortBrush}" Stroke="#FFFFFF" StrokeThickness="0.8" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding PortName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12.5" Margin="0,0,8,0" />
                                                <Border Background="#282832" BorderBrush="#484856" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                                    <TextBlock Text="{Binding TypeBadge}" Foreground="#00E5FF" FontSize="10.5" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="#C8C8D2" TextWrapping="Wrap" FontSize="11.5" Margin="17,1,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 3. Các cổng Đầu ra (Outputs - Bên phải thẻ) -->
                        <TextBlock Text="3. CỔNG ĐẦU RA (OUTPUTS — BÊN PHẢI THẺ)" FontWeight="Bold" Foreground="#2ECC71" Margin="0,2,0,5" />
                        <ItemsControl ItemsSource="{Binding SelectedNodeGuide.Outputs}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16161B" BorderBrush="#34343E" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,5">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Ellipse Width="10" Height="10" Fill="{Binding PortBrush}" Stroke="#FFFFFF" StrokeThickness="0.8" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding PortName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12.5" Margin="0,0,8,0" />
                                                <Border Background="#223228" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                                    <TextBlock Text="{Binding TypeBadge}" Foreground="#58F098" FontSize="10.5" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="#C8C8D2" TextWrapping="Wrap" FontSize="11.5" Margin="17,1,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 4. Ví dụ nối dây trên sơ đồ -->
                        <TextBlock Text="4. VÍ DỤ NỐI DÂY TRÊN SƠ ĐỒ" FontWeight="Bold" Foreground="#FFD166" Margin="0,2,0,5" />
                        <Border Background="#131820" BorderBrush="#2A4460" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedNodeGuide.WiringExample}" Foreground="#80E5FF" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" LineHeight="18" />
                        </Border>

                        <!-- 5. Mẹo thao tác nhanh -->
                        <TextBlock Text="5. MẸO THAO TÁC NHANH" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,5" />
                        <Border Background="#1E1915" BorderBrush="#6E4218" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,6">
                            <TextBlock Text="{Binding SelectedNodeGuide.UsageTips}" Foreground="#F0DEC8" TextWrapping="Wrap" FontSize="11.5" LineHeight="18" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#25252B" BorderBrush="#3E3E46" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Mẹo: Nhấn Enter hoặc F5 để áp dụng số thập phân ngay lập tức" Foreground="#888888" FontSize="11" />
                <Button DockPanel.Dock="Right" Content="Đóng (Close)" Click="OnCloseClick" Padding="14,4" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
